# ── Site ──────────────────────────────────────────────
# Public canonical origin used for Open Graph and metadata.
# Default: http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ── Sanity CMS (Optional) ─────────────────────────────
# If you leave these blank, the site will use the local JSON fallback data.
# You can get these from sanity.io > Project > Settings > API
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Server-side token — required for draft mode / unpublished content (Viewer role)
SANITY_API_READ_TOKEN=

# Draft Mode preview secret — enter any strong string here
SANITY_STUDIO_PREVIEW_SECRET=your-preview-secret-here
